# Copy to .env and adjust.
POSTGRES_PASSWORD=receipts

# Vision | OcrThenLlm
EXTRACTION_MODE=Vision
VISION_MODEL=qwen2.5vl:7b
# For "thinking" models (qwen3.x): false skips the reasoning pass — much faster for extraction
EXTRACTION_THINK=false
OCR_MODEL=qwen2.5vl:7b
TEXT_MODEL=qwen2.5:7b
# product code suggestions (text in, JSON out); empty = VISION_MODEL
ASSIST_MODEL=

# Use the bundled ollama container (default) or Ollama installed on the host:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
